# Emari Grill Environment Variables
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin User Email (for authorization check)
ADMIN_EMAIL=admin@emarigrill.com

# Optional WhatsApp number for direct chat (Nigerian format without leading + or 0, e.g. 2348012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Base URL (for Open Graph and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
